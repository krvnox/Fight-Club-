local PARRY_COOLDOWN = 0.08        -- tempo mínimo entre parries
local PARRY_PRESS_DURATION = 0.03  -- tempo que a tecla fica pressionada
local PARRY_RECOVERY = 0.05        -- pequena pausa após soltar
