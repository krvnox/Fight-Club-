-- Envio Seguro Anti-Kick (Rate-Limit & Proteção contra Desconexão do Servidor)
function CombatActions.Send(actionBuffer)
    if not PacketRemote then return end
    local now = tick()
    
    if CONFIG.ANTI_KICK_SAFETY then
        if now - SubaruState.LastPacketReset > 1 then
            SubaruState.RecentPacketCount = 0
            SubaruState.LastPacketReset = now
        end
        if SubaruState.RecentPacketCount >= 24 then
            return -- Throttle para ficar 100% abaixo do limite de kick do Roblox
        end
        SubaruState.RecentPacketCount = SubaruState.RecentPacketCount + 1
    end
    
    pcall(function()
        PacketRemote:FireServer(actionBuffer)
    end)
    SubaruState.LastAction = now
    SubaruState.LastRemoteSendTime = now
end

-- Dispara ataques M1 e inputs de combate 100% livres de inputs fantasmas para Celular
function CombatActions.PerformM1Attack(targetChar)
    local now = tick()
    SubaruState.LastAction = now
    
    -- 1. Disparo de Opcode Packet direto no servidor (sem tocar no touch/mouse)
    CombatActions.Send(ACTION_BUFFERS.PUNCH)
    
    -- 2. Ativação nativa da Tool equipada (sem simular clique de tela)
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
            end
        end
    end)
    
    -- 3. Dispara remotes descobertos de ataque
    if targetChar then
        local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
        for _, rem in ipairs(DiscoveredCombatRemotes) do
            pcall(function()
                if rem:IsA("RemoteEvent") then
                    local rn = rem.Name:lower()
                    if rn:find("hit") or rn:find("attack") or rn:find("combat") or rn:find("m1") or rn:find("damage") or rn:find("punch") then
                        if tRoot then
                            rem:FireServer(targetChar, tRoot.CFrame, "M1")
                            rem:FireServer("Hit", targetChar, tRoot.CFrame)
                            rem:FireServer("Attack")
                        else
                            rem:FireServer("Attack")
                            rem:FireServer("M1")
                        end
                    end
                end
            end)
        end
    end
end

