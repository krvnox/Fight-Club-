-- Dispara todos os remotes de defesa descobertos com payloads universais & Kick-Proof Debounce
function CombatActions.FireAllBlockRemotes(state)
    local now = tick()
    if CONFIG.ANTI_KICK_SAFETY and (now - SubaruState.LastRemoteSendTime < 0.02) then
        return
    end
    SubaruState.LastRemoteSendTime = now
    
    for _, rem in ipairs(DiscoveredCombatRemotes) do
        pcall(function()
            if rem:IsA("RemoteEvent") then
                local rn = rem.Name:lower()
                if rn:find("block") or rn:find("guard") or rn:find("parry") or rn:find("defend") then
                    rem:FireServer(state)
                    rem:FireServer("Block", state)
                    rem:FireServer("Guard", state)
                    rem:FireServer({ Action = "Block", State = state, Key = "F" })
                    rem:FireServer("F", state)
                end
            elseif rem:IsA("RemoteFunction") then
                local rn = rem.Name:lower()
                if rn:find("block") or rn:find("guard") or rn:find("parry") or rn:find("defend") then
                    rem:InvokeServer("Block", state)
                end
            end
        end)
    end
end

-- Controle Global do Estado de Defesa (Rápido, Confiável e 100% Livre para Locomoção e Joysticks)
function CombatActions.SetBlockState(state)
    SubaruState.IsBlocking = state
    
    -- [VETOR 1: Animação de Guarda - Apenas se Estiver Parado para NUNCA Congelar os Passos]
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if state and CONFIG.FORCE_VISIBLE_ANIMATION and hum.MoveDirection.Magnitude < 0.05 then
                PlayVisibleBlockAnimation(hum)
            else
                StopVisibleBlockAnimation(hum)
            end
            
            -- Restauração Imediata da Velocidade de Andar ao soltar a defesa
            if not state then
                local normalSpeed = math.max(SubaruState.SavedWalkSpeed or 16, 16)
                if hum.WalkSpeed < normalSpeed then
                    hum.WalkSpeed = normalSpeed
                end
                pcall(function()
                    hum.PlatformStand = false
                    hum.Sit = false
                end)
            end
        end
        
        -- [VETOR 2: Sincronização de Atributos Oficiais de Defesa]
        pcall(function()
            char:SetAttribute("Blocking", state)
            char:SetAttribute("Guard", state)
            char:SetAttribute("IsBlocking", state)
            char:SetAttribute("Parry", state)
            LocalPlayer:SetAttribute("Blocking", state)
        end)
    end
    
    -- [VETOR 3: Envio de Opcodes e Multi-Remotes sem Interromper o Joystick]
    if state then
        CombatActions.Send(ACTION_BUFFERS.BLOCK_ON)
        CombatActions.FireAllBlockRemotes(true)
    else
        CombatActions.Send(ACTION_BUFFERS.BLOCK_OFF)
        CombatActions.FireAllBlockRemotes(false)
    end
end

-- ==================== AUTO-BLOCK PURO & CONSCIENTE (SEM SPAM / PRIORIDADE TOTAL AO AUTO-COMBO) ====================
-- Executa Auto-Block sólido apenas quando atacado e NUNCA interrompe o Auto-Combo nem o andar
function CombatActions.TriggerAutoBlock(attackKey)
    if not CONFIG.AUTO_BLOCK_ENABLED then return end
    -- SE ESTIVER ATACANDO / EM AUTO-COMBO, O COMBO TEM 100% DE PRIORIDADE!
    if SubaruState.IsAttacking then return end
    if SubaruState.IsBlocking or isBlockQueued then return end
    
    local now = tick()
    
    -- 1. Cooldown de Guarda Estrito (0.35s) - Elimina completamente qualquer spam
    local minCooldown = CONFIG.GUARD_COOLDOWN or 0.35
    if now - SubaruState.LastBlockFinishedTime < minCooldown then return end
    if now - SubaruState.LastBlockTime < minCooldown then return end
    
    -- 2. Trava Estrita de 1 Bloqueio por Swing de Ataque (0.75s)
    if attackKey and SubaruState.HandledAttacks[attackKey] and (now - SubaruState.HandledAttacks[attackKey] < 0.75) then
        return
    end
    if attackKey then SubaruState.HandledAttacks[attackKey] = now end
    
    SubaruState.LastBlockTime = now
    isBlockQueued = true
    
    -- Duração curta e precisa de sustentação da guarda para cobrir o golpe e liberar o boneco na hora
    local blockHoldDuration = 0.18
    local reactionDelay = 0.002
    
    if CONFIG.HUMANIZE_BLOCK then
        local jitter = (math.random(-5, 10) / 1000)
        reactionDelay = math.max(0.02, (CONFIG.HUMAN_REACTION_DELAY or 0.10) + jitter)
        blockHoldDuration = math.max(0.16, (CONFIG.HUMAN_HOLD_DURATION or 0.20) + (math.random(-10, 10) / 1000))
    else
        blockHoldDuration = math.max(0.16, CONFIG.FAST_BLOCK_DURATION or 0.18)
    end
    
    task.delay(reactionDelay, function()
        isBlockQueued = false
        if not SubaruState.Enabled or SubaruState.IsAttacking then return end
        
        CombatActions.SetBlockState(true)
        
        if SubaruState.BlockThread then task.cancel(SubaruState.BlockThread) end
        
        -- Sustenta o bloqueio apenas durante o impacto e solta imediatamente para você poder andar e contra-atacar
        SubaruState.BlockThread = task.delay(blockHoldDuration, function()
            CombatActions.ReleaseBlock()
        end)
    end)
end

