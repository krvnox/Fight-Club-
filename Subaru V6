            tLbl.TextSize = 11
            tLbl.TextColor3 = COLORS.TextPrimary
            tLbl.TextXAlignment = Enum.TextXAlignment.Left
            tLbl.ZIndex = 14

            local vLbl = Instance.new("TextLabel", card)
            vLbl.Size = UDim2.new(0, 68, 0, 18)
            vLbl.Position = UDim2.new(1, -78, 0, 6)
            vLbl.BackgroundTransparency = 1
            vLbl.Text = tostring(initV) .. unit
            vLbl.Font = Enum.Font.Code
            vLbl.TextSize = 11
            vLbl.TextColor3 = COLORS.AccentBright
            vLbl.TextXAlignment = Enum.TextXAlignment.Right
            vLbl.ZIndex = 14

            local track = Instance.new("Frame", card)
            track.Size = UDim2.new(1, -24, 0, 8)
            track.Position = UDim2.new(0, 12, 0, 35)
            track.BackgroundColor3 = COLORS.SurfaceAlt
            track.ZIndex = 14
            Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

            local pct = math.clamp((initV - minV) / (maxV - minV), 0, 1)
            local fill = Instance.new("Frame", track)
            fill.Size = UDim2.new(pct, 0, 1, 0)
            fill.BackgroundColor3 = COLORS.Accent
            fill.ZIndex = 15
            Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

            local hit = Instance.new("TextButton", track)
            hit.Size = UDim2.new(1, 0, 1, 14)
            hit.Position = UDim2.new(0, 0, 0, -7)
            hit.BackgroundTransparency = 1
            hit.Text = ""
            hit.ZIndex = 16

            local dragging = false
            hit.MouseButton1Down:Connect(function() dragging = true end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                    local rel = math.clamp((inp.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
                    local val = minV + rel * (maxV - minV)
                    if step and step > 0 then val = math.floor((val / step) + 0.5) * step end
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    vLbl.Text = string.format("%.3f", val):gsub("%.?0+$", "") .. unit
                    callback(val)
                end
            end)
        end

