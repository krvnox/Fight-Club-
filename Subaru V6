-- ==================== GAME SENSE AI V6.0 ====================
local GameSense = {}

function GameSense.UpdateAdaptiveMode(localHpPercent, enemyHpPercent)
    if not CONFIG.SMART_HP_ADAPTIVE then
        ScarletState.AdaptiveMode = "DOMINANCE"
        return "DOMINANCE"
    end
    if enemyHpPercent and enemyHpPercent <= (CONFIG.ENEMY_EXECUTE_THRESHOLD or 25) then
        ScarletState.AdaptiveMode = "EXECUTE_RUSH"
        return "EXECUTE_RUSH"
    end
    if localHpPercent <= (CONFIG.HP_LOW_THRESHOLD or 30) then
        ScarletState.AdaptiveMode = "CLUTCH_SURVIVAL"
        return "CLUTCH_SURVIVAL"
    elseif localHpPercent >= (CONFIG.HP_HIGH_THRESHOLD or 70) then
        ScarletState.AdaptiveMode = "DOMINANCE"
        return "DOMINANCE"
    else
        ScarletState.AdaptiveMode = "TACTICAL"
        return "TACTICAL"
    end
end

function GameSense.AnalyzeTarget(targetChar)
    local analysis = {
        isValid = false,
        distance = 999,
        isFacingUs = false,
        isAttacking = false,
        attackKey = nil,
        isGuardBreak = false,
        isWhiffRecovery = false,
        isBlocking = false,
        isBlockSpamming = false,
        healthPercent = 100,
        optimalComboRoute = "CRIMSON_EXECUTION"
    }
    if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then return analysis end
    local pChar = LocalPlayer.Character
    if not pChar or not pChar:FindFirstChild("HumanoidRootPart") then return analysis end

    local pRoot = pChar.HumanoidRootPart
    local tRoot = targetChar.HumanoidRootPart
    local tHum = targetChar:FindFirstChildOfClass("Humanoid")
    if not tHum or tHum.Health <= 0 then return analysis end

    analysis.isValid = true
    analysis.distance = (pRoot.Position - tRoot.Position).Magnitude
    analysis.healthPercent = (tHum.Health / math.max(1, tHum.MaxHealth)) * 100

    local toPlayer = (pRoot.Position - tRoot.Position).Unit
    local dot = tRoot.CFrame.LookVector:Dot(toPlayer)
    analysis.isFacingUs = (dot > -0.2) or (analysis.distance <= (CONFIG.MAX_MELEE_REACH or 6.5))

    if targetChar:GetAttribute("Blocking") or targetChar:GetAttribute("Guard") or targetChar:GetAttribute("IsBlocking") then
        analysis.isBlocking = true
    end

    local bh = ScarletState.TargetBlockHistory[targetChar]
    if not bh then
        bh = { lastState = analysis.isBlocking, changes = 0, lastChangeTime = tick() }
        ScarletState.TargetBlockHistory[targetChar] = bh
    end
    if bh.lastState ~= analysis.isBlocking then
        bh.changes = bh.changes + 1
        bh.lastChangeTime = tick()
        bh.lastState = analysis.isBlocking
    end
    if tick() - bh.lastChangeTime > 1.5 then bh.changes = 0 end
    analysis.isBlockSpamming = (bh.changes >= 2) or analysis.isBlocking

    pcall(function()
        for _, track in ipairs(tHum:GetPlayingAnimationTracks()) do
            if track.IsPlaying and track.WeightCurrent > 0.15 then
                local combined = (tostring(track.Animation.AnimationId) .. " " .. tostring(track.Name)):lower()
                if combined:find("block") or combined:find("guard") or combined:find("defend") then
                    analysis.isBlocking = true
                    analysis.isBlockSpamming = true
                end
                if combined:find("heavy") or combined:find("guardbreak") or combined:find("smash") then
                    analysis.isGuardBreak = true
                end
                if not (combined:find("idle") or combined:find("walk") or combined:find("run")) then
                    if combined:find("attack") or combined:find("punch") or combined:find("kick") or combined:find("m1") or combined:find("swing") then
                        local progress = track.TimePosition / (track.Length > 0 and track.Length or 0.8)
                        if progress >= 0.05 and progress <= 0.70 then
                            analysis.isAttacking = true
                            analysis.attackKey = tostring(track.Animation.AnimationId) .. "_" .. tostring(math.floor(track.TimePosition * 4))
                        elseif progress > 0.70 then
                            analysis.isWhiffRecovery = true
                        end
                    end
                end
            end
        end
    end)

    if (analysis.isBlocking or analysis.isBlockSpamming) and CONFIG.GAME_SENSE_AUTO_READ_DEFENSE then
        analysis.optimalComboRoute = "ARMOR_SHATTER_LOOP"
        ScarletState.EnemyState = "GUARDING"
    elseif analysis.isWhiffRecovery and CONFIG.WHIFF_PUNISH_ENABLED then
        analysis.optimalComboRoute = "WHIFF_PUNISH_OBLITERATE"
        ScarletState.EnemyState = "WHIFFING"
    elseif ScarletState.AdaptiveMode == "EXECUTE_RUSH" or analysis.healthPercent <= (CONFIG.ENEMY_EXECUTE_THRESHOLD or 25) then
        analysis.optimalComboRoute = "EXECUTE_KILL_CONFIRM"
        ScarletState.EnemyState = "CRITICAL"
    elseif ScarletState.AdaptiveMode == "CLUTCH_SURVIVAL" then
        analysis.optimalComboRoute = "CLUTCH_COUNTER_REVERSAL"
        ScarletState.EnemyState = analysis.isAttacking and "ATTACKING" or "PRESSURE"
    else
        analysis.optimalComboRoute = "CRIMSON_EXECUTION"
        ScarletState.EnemyState = analysis.isAttacking and "ATTACKING" or "NEUTRAL"
    end

    return analysis
end

function GameSense.ShouldBlock(analysis)
    if not CONFIG.AUTO_BLOCK_ENABLED then return false end
    if ScarletState.IsAttacking then return false end
    if analysis.isGuardBreak and CONFIG.ANTI_GB_EVASION then return false end
    if not analysis.isFacingUs then return false end
    if analysis.distance > (CONFIG.MAX_MELEE_REACH or 6.5) then return false end
    if analysis.isWhiffRecovery or analysis.isBlocking then return false end
    if tick() - ScarletState.LastBlockFinishedTime < (CONFIG.GUARD_COOLDOWN or 0.25) then return false end
    return analysis.isAttacking
end

-- ==================== EXECUÇÃO DO COMBO BRUTAL ZERO-GAP ====================
local function ExecuteBrutalCombo(routeName, targetChar)
    if not ScarletState.Enabled then return end
    if ScarletState.IsAttacking or ScarletState.IsBlocking then return end
    if tick() - ScarletState.LastComboTime < (CONFIG.COMBO_DELAY or 0.004) then return end

    local route = BRUTAL_COMBO_ROUTES[routeName] or BRUTAL_COMBO_ROUTES.CRIMSON_EXECUTION
    ScarletState.ActiveComboName = routeName
    ScarletState.IsAttacking = true
    ScarletState.LastComboTime = tick()

    task.spawn(function()
        local m1Speed = math.max(0.011, CONFIG.PERFECT_M1_SPEED or 0.018)
        local kickSpeed = math.max(0.007, CONFIG.KICK_SPEED or 0.010)
        if CONFIG.BRUTAL_ZERO_GAP_CHAIN then
            m1Speed = math.max(0.010, m1Speed * 0.85)
            kickSpeed = math.max(0.007, kickSpeed * 0.85)
        end

        for _, moveToken in ipairs(route) do
            if targetChar and (not targetChar:FindFirstChild("Humanoid") or targetChar.Humanoid.Health <= 0) then break end
            if ScarletState.PriorityMode or ScarletState.IsBlocking then break end

            CombatActions.DispatchMove(moveToken, targetChar)
            EnforcePlayerMobility()
            local isPunch = (moveToken == "PUNCH" or moveToken == "BLINDSPOT_M1")
            task.wait(isPunch and m1Speed or kickSpeed)
        end

        ScarletState.IsAttacking = false
        EnforcePlayerMobility()
    end)
end

-- ==================== LOOP PRINCIPAL HEARTBEAT ====================
RunService.Heartbeat:Connect(function()
    if not ScarletState.Enabled then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 or not char:FindFirstChild("HumanoidRootPart") then
        CombatActions.ReleaseBlock()
        return
    end

    local hum = char.Humanoid
    local myHpPercent = (hum.Health / math.max(1, hum.MaxHealth)) * 100

    local closestEnemy = nil
    local shortestDist = CONFIG.DETECTION_RANGE
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local eHum = p.Character:FindFirstChildOfClass("Humanoid")
            if eHum and eHum.Health > 0 then
                local d = (char.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                if d < shortestDist then
                    shortestDist = d
                    closestEnemy = p.Character
                end
            end
        end
    end

    ScarletState.Target = closestEnemy
    ScarletState.TargetDistance = math.floor(shortestDist * 10) / 10

    if closestEnemy then
        local eHum = closestEnemy:FindFirstChildOfClass("Humanoid")
        local enemyHp = eHum and ((eHum.Health / math.max(1, eHum.MaxHealth)) * 100) or 100
        ScarletState.TargetName = closestEnemy.Name
        ScarletState.TargetHP = math.floor(enemyHp)

        GameSense.UpdateAdaptiveMode(myHpPercent, enemyHp)
        local analysis = GameSense.AnalyzeTarget(closestEnemy)

        if GameSense.ShouldBlock(analysis) then
            CombatActions.TriggerAutoBlock(analysis.attackKey)
        else
            if ScarletState.IsBlocking and (tick() - ScarletState.LastBlockTime > 0.05) then
                CombatActions.ReleaseBlock()
            end
            if CONFIG.AUTO_COMBO_ENABLED and analysis.distance <= CONFIG.ATTACK_RANGE then
                local chosenRoute = CONFIG.GAME_SENSE_ENABLED and analysis.optimalComboRoute or "CRIMSON_EXECUTION"
                ExecuteBrutalCombo(chosenRoute, closestEnemy)
            end
        end
    else
        ScarletState.TargetName = "Procurando Alvo..."
        ScarletState.TargetHP = 100
        ScarletState.EnemyState = "NEUTRAL"
        GameSense.UpdateAdaptiveMode(myHpPercent, 100)
    end
end)

