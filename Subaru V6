        -- ==================== DRAG SEGURO ISOLADO POR DEDO & TRAVA DE BOTÕES ====================
        local function EnableDrag(frame, handle, onTap, isHudButton)
            local dragging, moved = false, false
            local dragStart, startPos, activeInput
            handle.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    local locked = isHudButton and CONFIG.LOCK_HUD_BUTTONS
                    dragging = not locked
                    moved = false
                    activeInput = inp
                    dragStart = inp.Position
                    startPos = frame.Position
                    inp.Changed:Connect(function()
                        if inp.UserInputState == Enum.UserInputState.End then
                            dragging = false
                            activeInput = nil
                            if not moved and onTap then onTap() end
                        end
                    end)
                end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if not dragging then return end
                if isHudButton and CONFIG.LOCK_HUD_BUTTONS then return end
                local isSameTouch = (inp.UserInputType == Enum.UserInputType.Touch and inp == activeInput)
                local isMouseMove = (inp.UserInputType == Enum.UserInputType.MouseMovement and activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1)
                if isSameTouch or isMouseMove then
                    local delta = inp.Position - dragStart
                    if delta.Magnitude > 10 then moved = true end
                    if moved then
                        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                    end
                end
            end)
        end

