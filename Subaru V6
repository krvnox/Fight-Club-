function CombatActions.Send(actionBuffer)
    if not PacketRemote then return end
    local now = tick()
    if CONFIG.ANTI_KICK_SAFETY then
        if now - ScarletState.LastPacketReset > 1 then
            ScarletState.RecentPacketCount = 0
            ScarletState.LastPacketReset = now
        end
        if ScarletState.RecentPacketCount >= (CONFIG.PACKET_RATE_CAP or 36) then return end
        ScarletState.RecentPacketCount = ScarletState.RecentPacketCount + 1
    end
    pcall(function() PacketRemote:FireServer(actionBuffer) end)
    ScarletState.LastAction = now
    ScarletState.LastRemoteSendTime = now
end

-- Injeção de Triangulação 360° (Back 180°, Left -90°, Right +90°, Overhead)
function CombatActions.FireBlindspotMatrix(targetChar, moveTag)
    if not targetChar then return end
    local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then return end

    local vectors = {
        tRoot.CFrame * CFrame.new(0, 0, 1.45) * CFrame.Angles(0, math.pi, 0),
        tRoot.CFrame * CFrame.new(-1.45, 0, 0) * CFrame.Angles(0, math.rad(-90), 0),
        tRoot.CFrame * CFrame.new(1.45, 0, 0) * CFrame.Angles(0, math.rad(90), 0)
    }

    if CONFIG.BLINDSPOT_360_MATRIX then
        table.insert(vectors, tRoot.CFrame * CFrame.new(0, 1.3, 0.8) * CFrame.Angles(math.rad(-45), math.pi, 0))
    end

    for _, rem in ipairs(DiscoveredCombatRemotes) do
        pcall(function()
            if rem:IsA("RemoteEvent") then
                local rn = rem.Name:lower()
                if rn:find("hit") or rn:find("attack") or rn:find("combat") or rn:find("m1") or rn:find("damage") or rn:find("kick") then
                    for _, cf in ipairs(vectors) do
                        rem:FireServer(targetChar, cf, moveTag or "M1")
                        rem:FireServer("Hit", targetChar, cf)
                    end
                end
            end
        end)
    end
end

function CombatActions.PerformPerfectM1(targetChar, forceBlindspot)
    local now = tick()
    local interval = CONFIG.PERFECT_M1_SPEED or 0.018

    if ScarletState.AdaptiveMode == "DOMINANCE" or ScarletState.AdaptiveMode == "EXECUTE_RUSH" then
        interval = math.max(0.012, interval * 0.72)
    elseif ScarletState.AdaptiveMode == "CLUTCH_SURVIVAL" then
        interval = math.max(0.016, interval * 0.85)
    end
    if CONFIG.BRUTAL_ZERO_GAP_CHAIN then
        interval = math.max(0.011, interval * 0.85)
    end

    if now - ScarletState.LastM1Time < interval then return end
    ScarletState.LastM1Time = now
    ScarletState.LastAction = now
    ScarletState.ComboHitCount = ((ScarletState.ComboHitCount or 0) % 5) + 1
    ScarletState.TotalHitsLanded = ScarletState.TotalHitsLanded + 1

    CombatActions.Send(ACTION_BUFFERS.PUNCH)

    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and CONFIG.M1_FRAME_CANCEL then
                local cancelMult = CONFIG.M1_CANCEL_MULT or 5.0
                for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
                    local tn = tostring(tr.Name):lower()
                    if tn:find("punch") or tn:find("m1") or tn:find("attack") or tn:find("swing") then
                        tr:AdjustSpeed(cancelMult)
                    end
                end
            end
        end
    end)

    if targetChar then
        local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local isGuarding = (targetChar:GetAttribute("Blocking") or targetChar:GetAttribute("Guard") or targetChar:GetAttribute("IsBlocking")) == true
        for _, rem in ipairs(DiscoveredCombatRemotes) do
            pcall(function()
                if rem:IsA("RemoteEvent") then
                    local rn = rem.Name:lower()
                    if rn:find("hit") or rn:find("attack") or rn:find("combat") or rn:find("m1") or rn:find("damage") or rn:find("punch") then
                        if tRoot then
                            rem:FireServer(targetChar, tRoot.CFrame, "M1")
                            rem:FireServer("Hit", targetChar, tRoot.CFrame)
                            rem:FireServer("Attack", targetChar)
                            rem:FireServer("M1", targetChar)
                        else
                            rem:FireServer("Attack")
                            rem:FireServer("M1")
                        end
                    end
                end
            end)
        end
        if forceBlindspot or isGuarding or CONFIG.SHIELD_PIERCER or CONFIG.ANGLE_BYPASS then
            CombatActions.FireBlindspotMatrix(targetChar, "M1")
        end
        if isGuarding and CONFIG.ANTI_BLOCK_SPAM then
            task.spawn(function()
                CombatActions.PerformLowKick(targetChar)
            end)
        end
    end

    EnforcePlayerMobility()
end

function CombatActions.PerformLowKick(targetChar)
    ScarletState.LastAction = tick()
    ScarletState.TotalHitsLanded = ScarletState.TotalHitsLanded + 1
    CombatActions.Send(ACTION_BUFFERS.LOW_KICK)

    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animator = hum and (hum:FindFirstChildOfClass("Animator") or hum)
            if animator then
                for _, obj in ipairs(char:GetDescendants()) do
                    if obj:IsA("Animation") then
                        local an = obj.Name:lower()
                        if an:find("lowkick") or an:find("sweep") or (an:find("kick") and not an:find("high")) or an:find("leg") or an:find("skill1") or an == "e" then
                            local track = animator:LoadAnimation(obj)
                            track.Priority = Enum.AnimationPriority.Action
                            track.Looped = false
                            track:Play(0.01, 1, 1.5)
                            if CONFIG.KICK_FRAME_CANCEL then
                                task.delay(0.03, function()
                                    if track.IsPlaying then track:AdjustSpeed(CONFIG.KICK_CANCEL_MULT or 5.2) end
                                end)
                            end
                            break
                        end
                    end
                end
            end
        end
    end)

    for _, rem in ipairs(DiscoveredCombatRemotes) do
        pcall(function()
            if rem:IsA("RemoteEvent") then
                local rn = rem.Name:lower()
                if rn:find("kick") or rn:find("guardbreak") or rn:find("break") or rn:find("skill") or rn:find("attack") or rn:find("hit") or rn:find("e") or rn:find("combat") then
                    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                        local tRoot = targetChar.HumanoidRootPart
                        rem:FireServer(targetChar, tRoot.CFrame, "LowKick")
                        rem:FireServer("LowKick", targetChar, tRoot.CFrame)
                        rem:FireServer("GuardBreak", targetChar, tRoot.CFrame)
                        rem:FireServer("Sweep", targetChar, tRoot.CFrame)
                        rem:FireServer("E", targetChar)
                        rem:FireServer({ Action = "LowKick", Target = targetChar, Key = "E" })
                    else
                        rem:FireServer("LowKick")
                        rem:FireServer("GuardBreak")
                        rem:FireServer("E")
                    end
                end
            end
        end)
    end

    if targetChar and CONFIG.BLINDSPOT_360_MATRIX then
        CombatActions.FireBlindspotMatrix(targetChar, "LowKick")
    end
    EnforcePlayerMobility()
end

