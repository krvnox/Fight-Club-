function CombatActions.PerformGuardCrush(targetChar)
    CombatActions.PerformLowKick(targetChar)
    if targetChar then
        CombatActions.FireBlindspotMatrix(targetChar, "GuardBreak")
    end
    task.delay(0.015, function()
        CombatActions.PerformPerfectM1(targetChar, true)
    end)
end

function CombatActions.PerformRapidKickFlurry(targetChar, customCount)
    local count = customCount or CONFIG.KICK_BURST_COUNT or 12
    local speed = math.max(0.007, CONFIG.KICK_SPEED or 0.010)
    task.spawn(function()
        for i = 1, count do
            if targetChar and (not targetChar:FindFirstChild("Humanoid") or targetChar.Humanoid.Health <= 0) then break end
            if ScarletState.PriorityMode or ScarletState.IsBlocking then break end
            if i % 2 == 1 then
                CombatActions.PerformLowKick(targetChar)
            else
                CombatActions.PerformHighKick(targetChar)
            end
            task.wait(speed)
        end
    end)
end

function CombatActions.DispatchMove(moveToken, targetChar)
    if moveToken == "PUNCH" then
        CombatActions.PerformPerfectM1(targetChar, false)
    elseif moveToken == "BLINDSPOT_M1" then
        CombatActions.PerformPerfectM1(targetChar, true)
    elseif moveToken == "LOW_KICK" then
        CombatActions.PerformLowKick(targetChar)
    elseif moveToken == "HIGH_KICK" then
        CombatActions.PerformHighKick(targetChar)
    elseif moveToken == "GUARD_CRUSH" then
        CombatActions.PerformGuardCrush(targetChar)
    elseif moveToken == "HYPER_FLURRY_HIT" then
        if (ScarletState.ComboHitCount % 2) == 0 then
            CombatActions.PerformLowKick(targetChar)
        else
            CombatActions.PerformHighKick(targetChar)
        end
    else
        CombatActions.PerformPerfectM1(targetChar, false)
    end
end

-- ==================== AUTO-BLOCK & MANUAL BLOCK 0MS ====================
function CombatActions.FireAllBlockRemotes(state)
    local now = tick()
    if CONFIG.ANTI_KICK_SAFETY and (now - ScarletState.LastRemoteSendTime < 0.008) then return end
    ScarletState.LastRemoteSendTime = now
    for _, rem in ipairs(DiscoveredCombatRemotes) do
        pcall(function()
            if rem:IsA("RemoteEvent") then
                local rn = rem.Name:lower()
                if rn:find("block") or rn:find("guard") or rn:find("parry") or rn:find("defend") then
                    rem:FireServer(state)
                    rem:FireServer("Block", state)
                    rem:FireServer({ Action = "Block", State = state, Key = "F" })
                end
            end
        end)
    end
end

function CombatActions.SetBlockState(state)
    ScarletState.IsBlocking = state
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and not state then
            pcall(function() hum.PlatformStand = false; hum.Sit = false end)
        end
        pcall(function()
            char:SetAttribute("Blocking", state)
            char:SetAttribute("Guard", state)
            char:SetAttribute("IsBlocking", state)
            LocalPlayer:SetAttribute("Blocking", state)
        end)
    end
    if state then
        CombatActions.Send(ACTION_BUFFERS.BLOCK_ON)
        CombatActions.FireAllBlockRemotes(true)
    else
        CombatActions.Send(ACTION_BUFFERS.BLOCK_OFF)
        CombatActions.FireAllBlockRemotes(false)
    end
end

function CombatActions.ReleaseBlock()
    isBlockQueued = false
    if ScarletState.BlockThread then
        task.cancel(ScarletState.BlockThread)
        ScarletState.BlockThread = nil
    end
    ScarletState.LastBlockFinishedTime = tick()
    CombatActions.SetBlockState(false)
end

function CombatActions.TriggerManualBlock(state)
    isBlockQueued = false
    if ScarletState.BlockThread then
        task.cancel(ScarletState.BlockThread)
        ScarletState.BlockThread = nil
    end
    if state then
        ScarletState.IsAttacking = false
        ScarletState.IsBlocking = true
        ScarletState.LastBlockTime = tick()
        CombatActions.SetBlockState(true)
        pcall(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
                    local tn = tostring(tr.Name):lower()
                    if tn:find("block") or tn:find("guard") or tn:find("parry") then
                        tr:AdjustSpeed(5.0)
                    elseif tn:find("punch") or tn:find("m1") or tn:find("kick") then
                        tr:Stop(0.01)
                    end
                end
            end
        end)
    else
        CombatActions.ReleaseBlock()
    end
end

function CombatActions.TriggerAutoBlock(attackKey)
    if not CONFIG.AUTO_BLOCK_ENABLED then return end
    if ScarletState.IsAttacking or ScarletState.IsBlocking or isBlockQueued then return end
    local now = tick()
    local minCooldown = CONFIG.GUARD_COOLDOWN or 0.25
    if now - ScarletState.LastBlockFinishedTime < minCooldown then return end
    if now - ScarletState.LastBlockTime < minCooldown then return end
    if attackKey and ScarletState.HandledAttacks[attackKey] and (now - ScarletState.HandledAttacks[attackKey] < 0.70) then return end
    if attackKey then ScarletState.HandledAttacks[attackKey] = now end

    ScarletState.LastBlockTime = now
    isBlockQueued = true

    local holdTime = 0.11
    local reactDelay = 0.0
    if ScarletState.AdaptiveMode == "CLUTCH_SURVIVAL" then
        holdTime = CONFIG.CLUTCH_FLASH_PARRY_SPEED or 0.022
        reactDelay = 0.0
    elseif CONFIG.HUMANIZE_BLOCK then
        reactDelay = math.max(0.01, (CONFIG.HUMAN_REACTION_DELAY or 0.08) + (math.random(-8, 12) / 1000))
        holdTime = math.max(0.09, (CONFIG.HUMAN_HOLD_DURATION or 0.10) + (math.random(-10, 10) / 1000))
    end

    task.delay(reactDelay, function()
        isBlockQueued = false
        if not ScarletState.Enabled or ScarletState.IsAttacking then return end
        CombatActions.SetBlockState(true)
        if ScarletState.BlockThread then task.cancel(ScarletState.BlockThread) end
        ScarletState.BlockThread = task.delay(holdTime, function()
            CombatActions.ReleaseBlock()
        end)
    end)
