        local function AddTabButton(tabName, displayName, icon)
            local btn = Instance.new("TextButton")
            btn.Name = tabName .. "TabBtn"
            btn.Size = UDim2.new(0, 95, 0, 30)
            btn.BackgroundColor3 = (tabName == CurrentActiveTab) and Color3.fromRGB(244, 63, 94) or Color3.fromRGB(28, 12, 48)
            btn.Text = icon .. " " .. displayName
            btn.Font = Enum.Font.GothamSemibold
            btn.TextSize = 11
