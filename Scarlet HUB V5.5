            itemStroke.Thickness = 1
            itemStroke.Parent = item

            local titleLbl = Instance.new("TextLabel")
            titleLbl.Size = UDim2.new(1, -80, 0, 20)
            titleLbl.Position = UDim2.new(0, 10, 0, 6)
            titleLbl.BackgroundTransparency = 1
            titleLbl.Text = title
            titleLbl.Font = Enum.Font.GothamBold
            titleLbl.TextSize = 12
            titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            titleLbl.TextXAlignment = Enum.TextXAlignment.Left
            titleLbl.ZIndex = 14
            titleLbl.Parent = item

            local valLbl = Instance.new("TextLabel")
            valLbl.Size = UDim2.new(0, 70, 0, 20)
            valLbl.Position = UDim2.new(1, -78, 0, 6)
            valLbl.BackgroundTransparency = 1
            valLbl.Text = tostring(currentVal) .. unit
            valLbl.Font = Enum.Font.GothamBold
            valLbl.TextSize = 11
            valLbl.TextColor3 = Color3.fromRGB(244, 114, 182)
            valLbl.TextXAlignment = Enum.TextXAlignment.Right
            valLbl.ZIndex = 14
            valLbl.Parent = item

            local sliderTrack = Instance.new("Frame")
            sliderTrack.Size = UDim2.new(1, -20, 0, 10)
            sliderTrack.Position = UDim2.new(0, 10, 0, 36)
            sliderTrack.BackgroundColor3 = Color3.fromRGB(40, 20, 60)
            sliderTrack.ZIndex = 14
            sliderTrack.Parent = item

            local sCorner = Instance.new("UICorner")
            sCorner.CornerRadius = UDim.new(1, 0)
            sCorner.Parent = sliderTrack

            local pct = math.clamp((currentVal - minVal) / (maxVal - minVal), 0, 1)
            local sliderFill = Instance.new("Frame")
            sliderFill.Size = UDim2.new(pct, 0, 1, 0)
            sliderFill.BackgroundColor3 = Color3.fromRGB(244, 63, 94)
            sliderFill.ZIndex = 15
            sliderFill.Parent = sliderTrack

            local sfCorner = Instance.new("UICorner")
            sfCorner.CornerRadius = UDim.new(1, 0)
            sfCorner.Parent = sliderFill

            local sliderBtn = Instance.new("TextButton")
            sliderBtn.Size = UDim2.new(1, 0, 1, 0)
            sliderBtn.BackgroundTransparency = 1
            sliderBtn.Text = ""
            sliderBtn.ZIndex = 16
            sliderBtn.Parent = sliderTrack

            local dragging = false
            sliderBtn.MouseButton1Down:Connect(function() dragging = true end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local mousePos = input.Position.X
                    local trackAbsPos = sliderTrack.AbsolutePosition.X
                    local trackAbsSize = sliderTrack.AbsoluteSize.X
                    local rel = math.clamp((mousePos - trackAbsPos) / trackAbsSize, 0, 1)
                    local calculated = minVal + (rel * (maxVal - minVal))
                    if step and step > 0 then
                        calculated = math.floor((calculated / step) + 0.5) * step
                    end
                    sliderFill.Size = UDim2.new(rel, 0, 1, 0)
                    valLbl.Text = string.format("%.3f", calculated):gsub("%.?0+$", "") .. unit
                    onValChange(calculated)
                end
            end)
        end

