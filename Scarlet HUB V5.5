        local function CreateSliderItem(parent, title, minVal, maxVal, currentVal, step, unit, onValChange)
            local item = Instance.new("Frame")
            item.Size = UDim2.new(1, -6, 0, 60)
            item.BackgroundColor3 = Color3.fromRGB(20, 8, 36)
            item.ZIndex = 13
            item.Parent = parent

            local itemCorner = Instance.new("UICorner")
