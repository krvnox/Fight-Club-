                local rn = rem.Name:lower()
                if rn:find("kick") or rn:find("highkick") or rn:find("heavy") or rn:find("finisher") or rn:find("skill") or rn:find("q") or rn:find("combat") then
                    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                        local tRoot = targetChar.HumanoidRootPart
                        rem:FireServer(targetChar, tRoot.CFrame, "HighKick")
                        rem:FireServer("HighKick", targetChar, tRoot.CFrame)
                        rem:FireServer("Heavy", targetChar, tRoot.CFrame)
                        rem:FireServer("Finisher", targetChar, tRoot.CFrame)
                        rem:FireServer("Q", targetChar)
                        rem:FireServer("Skill2", targetChar)
                        rem:FireServer({ Action = "HighKick", Target = targetChar, Key = "Q" })
                        rem:FireServer({ Key = Enum.KeyCode.Q, Target = targetChar })
                    else
                        rem:FireServer("HighKick")
                        rem:FireServer("Heavy")
                        rem:FireServer("Q")
                        rem:FireServer("Skill2")
                        rem:FireServer({ Action = "HighKick", Key = "Q" })
                    end
                end
            end
        end)
    end

    -- 4. Garante preservação de velocidade e locomoção após chute alto
    EnforcePlayerMobility()
end

-- RAPID KICK FLURRY: Dispara uma rajada ultra-rápida e contínua de chutes sucessivos (Turbo 80+ KPS)
function CombatActions.PerformRapidKickFlurry(targetChar, customBurstCount)
    local count = customBurstCount or CONFIG.KICK_BURST_COUNT or 10
    local speed = CONFIG.KICK_SPEED or 0.010

    task.spawn(function()
        for i = 1, count do
            if not targetChar or not targetChar:FindFirstChild("Humanoid") or targetChar.Humanoid.Health <= 0 then break end
            if SubaruState.PriorityMode or SubaruState.IsBlocking then break end

            if i % 2 == 1 then
                CombatActions.PerformLowKick(targetChar)
            else
                CombatActions.PerformHighKick(targetChar)
            end
            task.wait(speed)
        end
    end)
end

function CombatActions.FireAllBlockRemotes(state)
    local now = tick()
    if CONFIG.ANTI_KICK_SAFETY and (now - SubaruState.LastRemoteSendTime < 0.01) then return end
    SubaruState.LastRemoteSendTime = now
    for _, rem in ipairs(DiscoveredCombatRemotes) do
        pcall(function()
            if rem:IsA("RemoteEvent") then
                local rn = rem.Name:lower()
                if rn:find("block") or rn:find("guard") or rn:find("parry") or rn:find("defend") then
                    rem:FireServer(state)
                    rem:FireServer("Block", state)
                    rem:FireServer({ Action = "Block", State = state, Key = "F" })
                end
            end
        end)
    end
end

function CombatActions.SetBlockState(state)
    SubaruState.IsBlocking = state
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and not state then
            pcall(function() hum.PlatformStand = false; hum.Sit = false end)
        end
        pcall(function()
            char:SetAttribute("Blocking", state)
            char:SetAttribute("Guard", state)
            char:SetAttribute("IsBlocking", state)
            LocalPlayer:SetAttribute("Blocking", state)
        end)
    end
    if state then
        CombatActions.Send(ACTION_BUFFERS.BLOCK_ON)
        CombatActions.FireAllBlockRemotes(true)
    else
        CombatActions.Send(ACTION_BUFFERS.BLOCK_OFF)
        CombatActions.FireAllBlockRemotes(false)
    end
end

-- ==================== MANUAL BLOCK TURBO (0ms RESPOSTA INSTANTÂNEA AO CLICAR NO BOTÃO) ====================
-- Bypassa todos os atrasos de humanização e debounces ao clicar no botão de Block ou apertar F
function CombatActions.TriggerManualBlock(state)
    isBlockQueued = false
    if SubaruState.BlockThread then
        task.cancel(SubaruState.BlockThread)
        SubaruState.BlockThread = nil
    end

    if state then
        -- 0ms: Interrompe qualquer combo ativo para priorizar a guarda com prioridade absoluta
        SubaruState.IsAttacking = false
        SubaruState.IsBlocking = true
        SubaruState.LastBlockTime = tick()

        -- 1. Disparo de Opcode Imediato
        CombatActions.Send(ACTION_BUFFERS.BLOCK_ON)
        
        -- 2. Disparo Multi-Remote Instantâneo
        CombatActions.FireAllBlockRemotes(true)

        -- 3. Aceleração de Animação de Guarda para 5.0x e corte de animações de ataque
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                char:SetAttribute("Blocking", true)
                char:SetAttribute("Guard", true)
                char:SetAttribute("IsBlocking", true)
                LocalPlayer:SetAttribute("Blocking", true)
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
                        local tn = tostring(tr.Name):lower()
                        if tn:find("block") or tn:find("guard") or tn:find("shield") or tn:find("parry") or tn:find("defend") then
                            tr:AdjustSpeed(5.0)
                        elseif tn:find("punch") or tn:find("m1") or tn:find("swing") or tn:find("attack") or tn:find("kick") then
                            tr:Stop(0.01)
                        end
                    end
                end
            end
        end)
    else
        -- 0ms: Solta a guarda e restaura mobilidade imediatamente
        CombatActions.ReleaseBlock()
    end
end

function CombatActions.TriggerAutoBlock(attackKey)
    if not CONFIG.AUTO_BLOCK_ENABLED then return end
    if SubaruState.IsAttacking or SubaruState.IsBlocking or isBlockQueued then return end
    local now = tick()
    local minCooldown = CONFIG.GUARD_COOLDOWN or 0.25
    if now - SubaruState.LastBlockFinishedTime < minCooldown then return end
    if now - SubaruState.LastBlockTime < minCooldown then return end
    if attackKey and SubaruState.HandledAttacks[attackKey] and (now - SubaruState.HandledAttacks[attackKey] < 0.75) then return end
    if attackKey then SubaruState.HandledAttacks[attackKey] = now end

    SubaruState.LastBlockTime = now
    isBlockQueued = true
    
    -- Duração de retenção de guarda adaptada ao Smart HP
    local blockHoldDuration = 0.12
    local reactionDelay = 0.000
    
    if SubaruState.AdaptiveMode == "CLUTCH_SURVIVAL" then
        blockHoldDuration = CONFIG.CLUTCH_FLASH_PARRY_SPEED or 0.025 -- Micro flash parry para fuga rápida
        reactionDelay = 0.000
    elseif CONFIG.HUMANIZE_BLOCK then
        reactionDelay = math.max(0.01, (CONFIG.HUMAN_REACTION_DELAY or 0.08) + (math.random(-5, 10)/1000))
        blockHoldDuration = math.max(0.10, (CONFIG.HUMAN_HOLD_DURATION or 0.10) + (math.random(-10, 10)/1000))
    end

    task.delay(reactionDelay, function()
        isBlockQueued = false
        if not SubaruState.Enabled or SubaruState.IsAttacking then return end
        CombatActions.SetBlockState(true)
        if SubaruState.BlockThread then task.cancel(SubaruState.BlockThread) end
        SubaruState.BlockThread = task.delay(blockHoldDuration, function()
            CombatActions.ReleaseBlock()
        end)
    end)
end

function CombatActions.ReleaseBlock()
    isBlockQueued = false
    if SubaruState.BlockThread then
        task.cancel(SubaruState.BlockThread)
        SubaruState.BlockThread = nil
    end
    SubaruState.LastBlockFinishedTime = tick()
    CombatActions.SetBlockState(false)
end

function CombatActions.ExecuteGuardBreak()
    local now = tick()
    if now - SubaruState.LastGuardBreakTime < 0.12 then return end
    SubaruState.LastGuardBreakTime = now
    CombatActions.PerformLowKick(SubaruState.Target)
    task.delay(0.05, function()
        CombatActions.PerformPerfectM1(SubaruState.Target)
    end)
end

function CombatActions.SendWithFlankBypass(actionInput, targetChar)
    local isLowKick = (actionInput == "LOW_KICK" or actionInput == "LOW" or actionInput == "E" or actionInput == "Sweep" or actionInput == ACTION_BUFFERS.LOW_KICK)
    local isHighKick = (actionInput == "HIGH_KICK" or actionInput == "HIGH" or actionInput == "Q" or actionInput == "Heavy" or actionInput == ACTION_BUFFERS.HIGH_KICK)

    if not targetChar then
        if isHighKick then
            CombatActions.PerformHighKick(nil)
        elseif isLowKick then
            CombatActions.PerformLowKick(nil)
        else
            CombatActions.PerformPerfectM1(nil)
        end
        return
    end

    local isEnemyBlocking = (targetChar:GetAttribute("Blocking") or targetChar:GetAttribute("Guard") or targetChar:GetAttribute("IsBlocking")) == true
    local tRoot = targetChar:FindFirstChild("HumanoidRootPart")

    -- Se o inimigo estiver defendendo ou com Shield Piercer ativo, injeta bypass em múltiplos ângulos cegos
    if (isEnemyBlocking or CONFIG.SHIELD_PIERCER) and tRoot then
        if CONFIG.ANGLE_BYPASS then
            pcall(function()
                -- Ângulo 180° (Costas) + 90° (Flancos) furam completamente o cone de defesa do Roblox
                local flankBack = tRoot.CFrame * CFrame.new(0, 0, 1.4) * CFrame.Angles(0, math.pi, 0)
                local flankLeft = tRoot.CFrame * CFrame.new(-1.4, 0, 0) * CFrame.Angles(0, math.rad(-90), 0)
                local flankRight = tRoot.CFrame * CFrame.new(1.4, 0, 0) * CFrame.Angles(0, math.rad(90), 0)

                for _, rem in ipairs(DiscoveredCombatRemotes) do
                    if rem:IsA("RemoteEvent") then
                        rem:FireServer("Hit", targetChar, flankBack)
                        rem:FireServer("M1", targetChar, flankBack)
                        rem:FireServer("Hit", targetChar, flankLeft)
                        rem:FireServer("Hit", targetChar, flankRight)
                    end
                end
            end)
        end

        if isHighKick then
            CombatActions.PerformHighKick(targetChar)
        elseif isLowKick then
            CombatActions.PerformLowKick(targetChar)
        else
            CombatActions.PerformPerfectM1(targetChar)
        end

        if CONFIG.ANTI_BLOCK_SPAM then
            task.spawn(CombatActions.ExecuteGuardBreak)
        end
    else
        if isHighKick then
            CombatActions.PerformHighKick(targetChar)
        elseif isLowKick then
            CombatActions.PerformLowKick(targetChar)
        else
            CombatActions.PerformPerfectM1(targetChar)
        end
    end
end

-- ==================== MÓDULO COMBAT GAME SENSE AI & DECISÃO DE COMBOS ====================
local GameSense = {}

-- Atualiza o modo adaptativo baseado na vida do jogador e do inimigo
function GameSense.UpdateAdaptiveMode(localHpPercent, enemyHpPercent)
    if not CONFIG.SMART_HP_ADAPTIVE then
        SubaruState.AdaptiveMode = "DOMINANCE"
        return "DOMINANCE"
    end
    
    if enemyHpPercent and enemyHpPercent <= (CONFIG.ENEMY_EXECUTE_THRESHOLD or 25) then
        SubaruState.AdaptiveMode = "EXECUTE_RUSH"
        return "EXECUTE_RUSH"
    end
    
    if localHpPercent <= (CONFIG.HP_LOW_THRESHOLD or 30) then
        SubaruState.AdaptiveMode = "CLUTCH_SURVIVAL"
        return "CLUTCH_SURVIVAL"
    elseif localHpPercent >= (CONFIG.HP_HIGH_THRESHOLD or 70) then
        SubaruState.AdaptiveMode = "DOMINANCE"
        return "DOMINANCE"
    else
        SubaruState.AdaptiveMode = "TACTICAL"
        return "TACTICAL"
    end
end

function GameSense.AnalyzeTarget(targetChar)
    local analysis = {
        isValid = false,
        distance = 999,
        isFacingUs = false,
        isInMeleeReach = false,
        isAttacking = false,
        attackKey = nil,
        isGuardBreak = false,
        isWhiffRecovery = false,
        isKnockedDownIFrame = false,
        isStunnedOrRagdoll = false,
        isBlocking = false,
        healthPercent = 100,
        threatVerdict = "SAFE",
        optimalComboType = "HYBRID_PUNCH_KICK"
    }
    if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then return analysis end
    local pChar = LocalPlayer.Character
    if not pChar or not pChar:FindFirstChild("HumanoidRootPart") then return analysis end

    local pRoot = pChar.HumanoidRootPart
    local tRoot = targetChar.HumanoidRootPart
    local tHum = targetChar:FindFirstChildOfClass("Humanoid")
    if not tHum or tHum.Health <= 0 then return analysis end

    analysis.isValid = true
    analysis.distance = (pRoot.Position - tRoot.Position).Magnitude
    analysis.healthPercent = (tHum.Health / tHum.MaxHealth) * 100

    local toPlayer = (pRoot.Position - tRoot.Position).Unit
    local dotProduct = tRoot.CFrame.LookVector:Dot(toPlayer)
    analysis.isFacingUs = (dotProduct > -0.2) or (analysis.distance <= (CONFIG.MAX_MELEE_REACH or 8.5))
    analysis.isInMeleeReach = (analysis.distance <= (CONFIG.MAX_MELEE_REACH or 6.5))

    if targetChar:GetAttribute("Blocking") or targetChar:GetAttribute("Guard") or targetChar:FindFirstChild("BlockEffect") then
        analysis.isBlocking = true
    end

    -- Detector de Spam de Block (Rastreia oscilação rápida de F / Shield)
    local targetId = targetChar
    if not SubaruState.TargetBlockHistory[targetId] then
        SubaruState.TargetBlockHistory[targetId] = {
            lastState = analysis.isBlocking,
            changes = 0,
            lastChangeTime = tick()
        }
    end
    local bh = SubaruState.TargetBlockHistory[targetId]
    if bh.lastState ~= analysis.isBlocking then
        bh.changes = bh.changes + 1
        bh.lastChangeTime = tick()
        bh.lastState = analysis.isBlocking
        if not analysis.isBlocking then
            SubaruState.LastBlockDropTime = tick()
        end
    end
    if tick() - bh.lastChangeTime > 1.5 then
        bh.changes = 0
    end
    analysis.isBlockSpamming = (bh.changes >= 2) or analysis.isBlocking

    local tracks = {}
    pcall(function()
        for _, tr in ipairs(tHum:GetPlayingAnimationTracks()) do table.insert(tracks, tr) end
    end)
    for _, track in ipairs(tracks) do
        if track.IsPlaying and track.WeightCurrent > 0.15 then
            local combined = (tostring(track.Animation.AnimationId) .. " " .. tostring(track.Name)):lower()
            if combined:find("block") or combined:find("guard") or combined:find("defend") then
                analysis.isBlocking = true
                analysis.isBlockSpamming = true
            end
            if combined:find("heavy") or combined:find("guardbreak") or combined:find("smash") then
                analysis.isGuardBreak = true
            end
            if not (combined:find("idle") or combined:find("walk") or combined:find("run")) then
                if combined:find("attack") or combined:find("punch") or combined:find("kick") or combined:find("m1") or combined:find("slash") or combined:find("swing") then
                    local progress = track.TimePosition / (track.Length > 0 and track.Length or 0.8)
                    if progress >= 0.05 and progress <= 0.70 then
                        analysis.isAttacking = true
                        analysis.attackKey = tostring(track.Animation.AnimationId) .. "_" .. tostring(math.floor(track.TimePosition * 4))
                    elseif progress > 0.70 then
                        analysis.isWhiffRecovery = true
                    end
                end
            end
        end
    end

    -- Determinador Tático de Combo do Game Sense (Sabe exatamente o combo mais letal para a situação)
    if analysis.isBlocking or analysis.isBlockSpamming then
        analysis.optimalComboType = "GUARD_BREAKER_COMBO" -- Rasteira / Chute E + Bypass Blindspot para furar block spam
    elseif analysis.isWhiffRecovery then
        analysis.optimalComboType = "WHIFF_PUNISH_BURST" -- Punição devastadora no erro do oponente
    elseif analysis.isAttacking and not analysis.isGuardBreak then
        analysis.optimalComboType = "COUNTER_INTERRUPT" -- Interrompe com chute de prioridade rápida
    elseif analysis.healthPercent <= 25 then
        analysis.optimalComboType = "EXECUTE_FINISHER" -- Rajada máxima de socos e chutes para finalizar
    else
        analysis.optimalComboType = "HYBRID_PUNCH_KICK" -- Combinação mais forte do jogo (M1 + Chutes E/Q)
    end

    return analysis
end

function GameSense.ShouldBlock(analysis)
    if not CONFIG.AUTO_BLOCK_ENABLED then return false, "DISABLED" end
    if SubaruState.IsAttacking then return false, "ATTACKING" end
    if analysis.isGuardBreak and CONFIG.ANTI_GB_EVASION then return false, "GUARD_BREAK_EVASION" end
    if not analysis.isFacingUs then return false, "NOT_FACING" end
    if analysis.distance > (CONFIG.MAX_MELEE_REACH or 6.5) then return false, "OUT_OF_RANGE" end
    if analysis.isWhiffRecovery or analysis.isBlocking or analysis.isStunnedOrRagdoll then return false, "NO_DANGER" end
    if tick() - SubaruState.LastBlockFinishedTime < (CONFIG.GUARD_COOLDOWN or 0.35) then return false, "COOLDOWN" end
    if analysis.isAttacking then return true, "REAL_THREAT" end
    return false, "NEUTRAL"
end

-- ==================== EXECUÇÃO DE COMBO INTELIGENTE (GAME SENSE TÁTICO TURBO) ====================
local function ExecuteSmartCombo(comboVerdict, targetChar)
    if not SubaruState.Enabled then return end
    if SubaruState.IsAttacking or SubaruState.IsBlocking then return end
    if tick() - SubaruState.LastComboTime < (CONFIG.COMBO_DELAY or 0.005) then return end

    SubaruState.IsAttacking = true
    SubaruState.LastComboTime = tick()

    task.spawn(function()
        local sequence = {}
        local m1Speed = math.max(0.016, CONFIG.PERFECT_M1_SPEED or 0.022)
        local kickSpeed = math.max(0.010, CONFIG.KICK_SPEED or 0.012)
        local kickBurst = math.max(6, CONFIG.KICK_BURST_COUNT or 10)

        -- 1. SE O INIMIGO ESTÁ BLOQUEANDO: Quebra de Guarda com Chute Baixo (E) + Rajada de Chutes Fortes
        if comboVerdict == "GUARD_BREAKER_COMBO" or (targetChar and (targetChar:GetAttribute("Blocking") or targetChar:GetAttribute("Guard"))) then
            table.insert(sequence, "LOW_KICK")  -- Rasteira quebra-guarda imediata (E)
            table.insert(sequence, kickSpeed)
            table.insert(sequence, "HIGH_KICK") -- Chute alto aproveitando quebra (Q)
            table.insert(sequence, kickSpeed)
            table.insert(sequence, "PUNCH")     -- Soco M1
            table.insert(sequence, m1Speed)
            table.insert(sequence, "HIGH_KICK") -- Chute alto (Q)
            table.insert(sequence, kickSpeed)
            table.insert(sequence, "LOW_KICK")  -- Rasteira finalizadora (E)
            table.insert(sequence, kickSpeed)

        -- 2. SE O INIMIGO ERROU GOLPE (WHIFF RECOVERY): Punição Máxima M1 + Chutes Rápidos
        elseif comboVerdict == "WHIFF_PUNISH_BURST" then
            table.insert(sequence, "PUNCH")
            table.insert(sequence, m1Speed)
            table.insert(sequence, "HIGH_KICK")
            table.insert(sequence, kickSpeed)
            table.insert(sequence, "PUNCH")
            table.insert(sequence, m1Speed)
            table.insert(sequence, "LOW_KICK")
            table.insert(sequence, kickSpeed)
            table.insert(sequence, "HIGH_KICK")
            table.insert(sequence, kickSpeed)

        -- 3. SE O INIMIGO ESTÁ COM POUCA VIDA (<25%): EXECUTE RUSH - Finalizador Implacável de Chutes
        elseif comboVerdict == "EXECUTE_FINISHER" or SubaruState.AdaptiveMode == "EXECUTE_RUSH" then
            local ultraKickSpeed = math.max(0.008, kickSpeed * 0.70)
            table.insert(sequence, "PUNCH")
            table.insert(sequence, m1Speed)
            table.insert(sequence, "HIGH_KICK")
            table.insert(sequence, ultraKickSpeed)
            table.insert(sequence, "LOW_KICK")
            table.insert(sequence, ultraKickSpeed)
            table.insert(sequence, "HIGH_KICK")
            table.insert(sequence, ultraKickSpeed)
            table.insert(sequence, "PUNCH")
            table.insert(sequence, m1Speed)
            table.insert(sequence, "HIGH_KICK")
            table.insert(sequence, ultraKickSpeed)
            table.insert(sequence, "LOW_KICK")
            table.insert(sequence, ultraKickSpeed)

        -- 4. SE NOSSA VIDA ESTÁ CRÍTICA (<30%): Clutch Knockback (Rasteira de afastamento + Soco)
        elseif SubaruState.AdaptiveMode == "CLUTCH_SURVIVAL" then
            table.insert(sequence, "LOW_KICK")  -- Desestabiliza com rasteira (E)
            table.insert(sequence, kickSpeed)
            table.insert(sequence, "PUNCH")     -- Soco para manter pressão
            table.insert(sequence, m1Speed)
            table.insert(sequence, "HIGH_KICK") -- Chute de knockback (Q)
            table.insert(sequence, kickSpeed * 1.05)

        -- 5. COMBO PADRÃO MAIS FORTE DO JOGO: HYBRID PUNCH & HIGH-FREQUENCY KICKS
        -- (M1 -> Low Kick E -> M1 -> High Kick Q -> Low Kick E -> High Kick Q)
        else
            table.insert(sequence, "PUNCH")
            table.insert(sequence, m1Speed)
            table.insert(sequence, "LOW_KICK")
            table.insert(sequence, kickSpeed)
            table.insert(sequence, "PUNCH")
            table.insert(sequence, m1Speed)
            table.insert(sequence, "HIGH_KICK")
            table.insert(sequence, kickSpeed)
            table.insert(sequence, "LOW_KICK")
            table.insert(sequence, kickSpeed)
            table.insert(sequence, "HIGH_KICK")
            table.insert(sequence, kickSpeed)
            for k = 1, math.max(0, kickBurst - 6) do
                local kb = (k % 2 == 1) and "LOW_KICK" or "HIGH_KICK"
                table.insert(sequence, kb)
                table.insert(sequence, kickSpeed)
            end
        end

        -- Executa a cadeia com bypass e registro limpo
        for i = 1, #sequence, 2 do
            if not SubaruState.Target or not SubaruState.Target:FindFirstChild("Humanoid") or SubaruState.Target.Humanoid.Health <= 0 then break end
            if SubaruState.PriorityMode or SubaruState.IsBlocking then break end
            
            local move = sequence[i]
            local delayTime = sequence[i+1] or kickSpeed
            CombatActions.SendWithFlankBypass(move, SubaruState.Target)
            EnforcePlayerMobility()
            task.wait(delayTime)
        end
        SubaruState.IsAttacking = false
        EnforcePlayerMobility()
    end)
end

-- ==================== LOOP PRINCIPAL HEARTBEAT (GAME SENSE & DECISÃO) ====================
RunService.Heartbeat:Connect(function()
    if not SubaruState.Enabled then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 or not char:FindFirstChild("HumanoidRootPart") then
        CombatActions.ReleaseBlock()
        return
    end

    local hum = char.Humanoid
    local myHpPercent = (hum.Health / hum.MaxHealth) * 100

    -- 1. Varredura do Inimigo Mais Próximo
    local closestEnemy = nil
    local shortestDist = CONFIG.DETECTION_RANGE
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local enemyHum = p.Character:FindFirstChild("Humanoid")
            if enemyHum and enemyHum.Health > 0 then
                local d = (char.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                if d < shortestDist then
                    shortestDist = d
                    closestEnemy = p.Character
                end
            end
        end
    end
    SubaruState.Target = closestEnemy

    if closestEnemy and closestEnemy:FindFirstChild("HumanoidRootPart") then
        local enemyHum = closestEnemy:FindFirstChildOfClass("Humanoid")
        local enemyHpPercent = enemyHum and ((enemyHum.Health / enemyHum.MaxHealth) * 100) or 100
        
        -- Atualiza Smart HP Adaptive Mode
        GameSense.UpdateAdaptiveMode(myHpPercent, enemyHpPercent)

        local analysis = GameSense.AnalyzeTarget(closestEnemy)
        local shouldBlock = GameSense.ShouldBlock(analysis)

        if shouldBlock then
            CombatActions.TriggerAutoBlock(analysis.attackKey)
        else
            if SubaruState.IsBlocking and (tick() - SubaruState.LastBlockTime > 0.05) then
                CombatActions.ReleaseBlock()
            end

            -- Disparo do Auto-Combo com Game Sense Inteligente e Chutes Híbridos
            if CONFIG.AUTO_COMBO_ENABLED and analysis.distance <= CONFIG.ATTACK_RANGE then
                local targetCombo = (CONFIG.GAME_SENSE_ENABLED and analysis.optimalComboType) or "HYBRID_PUNCH_KICK"
                ExecuteSmartCombo(targetCombo, closestEnemy)
            end
        end
    else
        SubaruState.AdaptiveMode = GameSense.UpdateAdaptiveMode(myHpPercent, 100)
    end
end)

