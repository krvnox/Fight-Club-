-- ==================== PRESERVAÇÃO DE MOBILIDADE NATIVA (SEM HACK DE VELOCIDADE) ====================
-- Garante física limpa e destravada sem interferir na velocidade de andar natural do jogo
local function EnforcePlayerMobility()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health <= 0 or not root then return end

        -- Apenas destrava estados físicos anormais sem alterar WalkSpeed
        if hum.PlatformStand then hum.PlatformStand = false end
        if hum.Sit then hum.Sit = false end
        if root.Anchored then root.Anchored = false end
    end)
end

-- Monitoramento leve para garantir física destravada
RunService.Stepped:Connect(EnforcePlayerMobility)

function CombatActions.Send(actionBuffer)
    if not PacketRemote then return end
    local now = tick()
    if CONFIG.ANTI_KICK_SAFETY then
        if now - SubaruState.LastPacketReset > 1 then
            SubaruState.RecentPacketCount = 0
            SubaruState.LastPacketReset = now
        end
        if SubaruState.RecentPacketCount >= 30 then return end
        SubaruState.RecentPacketCount = SubaruState.RecentPacketCount + 1
    end
    pcall(function() PacketRemote:FireServer(actionBuffer) end)
    SubaruState.LastAction = now
    SubaruState.LastRemoteSendTime = now
end

-- PERFECT M1 & AUTO-COMBO HÍBRIDO TURBO: Execução 100% livre de toque fantasma com animação e dano
function CombatActions.PerformPerfectM1(targetChar)
    local now = tick()
    local interval = CONFIG.PERFECT_M1_SPEED or 0.022
    
    if SubaruState.AdaptiveMode == "DOMINANCE" or SubaruState.AdaptiveMode == "EXECUTE_RUSH" then
        interval = math.max(0.016, interval * 0.75)
    elseif SubaruState.AdaptiveMode == "CLUTCH_SURVIVAL" then
        interval = math.max(0.020, interval * 0.85)
    end
    
    if now - SubaruState.LastM1Time < interval then return end
    SubaruState.LastM1Time = now
    SubaruState.LastAction = now
    SubaruState.ComboHitCount = ((SubaruState.ComboHitCount or 0) % 5) + 1

    -- 1. Opcode imediato de soco via PacketRemote
    CombatActions.Send(ACTION_BUFFERS.PUNCH)

    -- 2. Ativação via Tool do Personagem (Dispara o ataque e acelera animação nativa)
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and CONFIG.M1_FRAME_CANCEL then
                for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
                    local tn = tostring(tr.Name):lower()
                    if tn:find("punch") or tn:find("m1") or tn:find("attack") or tn:find("swing") then
                        tr:AdjustSpeed(4.5)
                    end
                end
            end
        end
    end)

    -- 3. Disparo Multi-Remote de Hit / M1 com Anti-Block Spam & Blindspot Bypass (180° / Flank)
    if targetChar then
        local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local isEnemyGuarding = (targetChar:GetAttribute("Blocking") or targetChar:GetAttribute("Guard") or targetChar:GetAttribute("IsBlocking")) == true
        
        -- Calcula vetores em ângulos cegos (Costas 180° e Flancos) para bypassar 100% o escudo frontal de quem spamma block
        local blindspotBack = tRoot and (tRoot.CFrame * CFrame.new(0, 0, 1.35) * CFrame.Angles(0, math.pi, 0)) or nil
        local blindspotFlank = tRoot and (tRoot.CFrame * CFrame.new(1.35, 0, 0) * CFrame.Angles(0, math.rad(90), 0)) or nil

        for _, rem in ipairs(DiscoveredCombatRemotes) do
            pcall(function()
                if rem:IsA("RemoteEvent") then
                    local rn = rem.Name:lower()
                    if rn:find("hit") or rn:find("attack") or rn:find("combat") or rn:find("m1") or rn:find("damage") or rn:find("punch") or rn:find("swing") then
                        if tRoot then
                            -- Disparo frontal padrão
                            rem:FireServer(targetChar, tRoot.CFrame, "M1")
                            rem:FireServer("Hit", targetChar, tRoot.CFrame)
                            rem:FireServer("Attack", targetChar)
                            rem:FireServer("M1", targetChar)

                            -- Injeção de Bypass em Ângulo Cego (Ignora a caixa frontal de colisão de block)
                            if (isEnemyGuarding or CONFIG.SHIELD_PIERCER or CONFIG.ANGLE_BYPASS) and blindspotBack then
                                rem:FireServer(targetChar, blindspotBack, "M1")
                                rem:FireServer("Hit", targetChar, blindspotBack)
                                rem:FireServer(targetChar, blindspotFlank, "M1")
                                rem:FireServer("Hit", targetChar, blindspotFlank)
                            end
                        else
                            rem:FireServer("Attack")
                            rem:FireServer("M1")
                        end
                    end
                end
            end)
        end

        -- Se o oponente estiver defendendo ou spamando block, dispara rasteira quebra-guarda automática
        if isEnemyGuarding and CONFIG.ANTI_BLOCK_SPAM then
            task.spawn(function()
                CombatActions.PerformLowKick(targetChar)
            end)
        end
    else
        for _, rem in ipairs(DiscoveredCombatRemotes) do
            pcall(function()
                if rem:IsA("RemoteEvent") then
                    local rn = rem.Name:lower()
                    if rn:find("attack") or rn:find("combat") or rn:find("m1") or rn:find("punch") or rn:find("swing") then
                        rem:FireServer("Attack")
                        rem:FireServer("M1")
                    end
                end
            end)
        end
    end

    -- 4. Preserva locomoção e destrava o analógico/WASD imediatamente
    EnforcePlayerMobility()

    -- 5. Auto-Chain Híbrido: Encadeamento automático de chutes sem interferir no andar
    if (CONFIG.M1_AUTO_CHAIN or CONFIG.HYBRID_PUNCH_KICK_CHAIN) and targetChar then
        if SubaruState.ComboHitCount == 2 then
            task.delay(interval * 0.60, function()
                CombatActions.PerformLowKick(targetChar)
            end)
        elseif SubaruState.ComboHitCount == 4 then
            task.delay(interval * 0.60, function()
                CombatActions.PerformHighKick(targetChar)
            end)
        end
    end
end

-- LOW KICK (CHUTE BAIXO / RASTEIRA - TECLA E): Execução Direta Sem Toque Fantasma
function CombatActions.PerformLowKick(targetChar)
    local now = tick()
    SubaruState.LastAction = now

    -- 1. Envia Opcode do PacketRemote
    CombatActions.Send(ACTION_BUFFERS.LOW_KICK)

    -- 2. Disparo de Animação do Personagem / Animator (Priority Action acelerada)
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animator = hum and (hum:FindFirstChildOfClass("Animator") or hum)
            if animator then
                for _, obj in ipairs(char:GetDescendants()) do
                    if obj:IsA("Animation") then
                        local an = obj.Name:lower()
                        if an:find("lowkick") or an:find("sweep") or (an:find("kick") and not an:find("high")) or an:find("leg") or an:find("skill1") or an == "e" then
                            local track = animator:LoadAnimation(obj)
                            track.Priority = Enum.AnimationPriority.Action
                            track.Looped = false
                            track:Play(0.02, 1, 1.4)
                            if CONFIG.KICK_FRAME_CANCEL then
                                task.delay(0.04, function()
                                    if track.IsPlaying then track:AdjustSpeed(4.5) end
                                end)
                            end
                            break
                        end
                    end
                end
            end
        end
    end)

    -- 3. Disparo Universal de Remotes de Chute Baixo / Quebra de Guarda / Tecla E (Direto nos Remotes)
    for _, rem in ipairs(DiscoveredCombatRemotes) do
        pcall(function()
            if rem:IsA("RemoteEvent") then
                local rn = rem.Name:lower()
                if rn:find("kick") or rn:find("guardbreak") or rn:find("break") or rn:find("skill") or rn:find("attack") or rn:find("hit") or rn:find("e") or rn:find("combat") then
                    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                        local tRoot = targetChar.HumanoidRootPart
                        rem:FireServer(targetChar, tRoot.CFrame, "LowKick")
                        rem:FireServer("LowKick", targetChar, tRoot.CFrame)
                        rem:FireServer("Kick", targetChar, tRoot.CFrame)
                        rem:FireServer("GuardBreak", targetChar, tRoot.CFrame)
                        rem:FireServer("Sweep", targetChar, tRoot.CFrame)
                        rem:FireServer("E", targetChar)
                        rem:FireServer("Skill1", targetChar)
                        rem:FireServer({ Action = "LowKick", Target = targetChar, Key = "E" })
                        rem:FireServer({ Key = Enum.KeyCode.E, Target = targetChar })
                    else
                        rem:FireServer("LowKick")
                        rem:FireServer("Kick")
                        rem:FireServer("GuardBreak")
                        rem:FireServer("E")
                        rem:FireServer("Skill1")
                        rem:FireServer({ Action = "LowKick", Key = "E" })
                    end
                end
            end
        end)
    end

    -- 4. Garante preservação de velocidade e locomoção após chute
    EnforcePlayerMobility()
end

