        CreateActionButton(cfgFrame, "Destravar Física & Animações", "🏃", function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                pcall(function()
                    char:FindFirstChildOfClass("Humanoid").PlatformStand = false
                    char:FindFirstChildOfClass("Humanoid").Sit = false
                end)
            end
        end)

        CreateActionButton(cfgFrame, "Re-escanear Remotes de Combate", "🔄", function()
            ScanForCombatRemotes()
        end)

        CreateActionButton(cfgFrame, "Fechar / Destruir Hub", "❌", function()
            ScreenGui:Destroy()
        end)

        -- ==================== BOTÕES RÁPIDOS TOUCH NA TELA (HUD QUICK ACTIONS V5.5 TURBO) ====================
        -- 1. Botão Rápido de Block Manual Instantâneo (F) - Ultra Responsivo & Tátil
        local QuickBlockBtn = Instance.new("TextButton")
        QuickBlockBtn.Name = "ScarletQuickBlock"
        QuickBlockBtn.Size = UDim2.new(0, 64, 0, 64)
        QuickBlockBtn.Position = UDim2.new(1, -84, 0.65, 0)
        QuickBlockBtn.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
        QuickBlockBtn.Text = "🛡️\nBLOCK"
        QuickBlockBtn.TextColor3 = Color3.fromRGB(56, 189, 248)
        QuickBlockBtn.Font = Enum.Font.GothamBold
        QuickBlockBtn.TextSize = 11
        QuickBlockBtn.Active = true
        QuickBlockBtn.AutoButtonColor = false
        QuickBlockBtn.ZIndex = 120
        QuickBlockBtn.Parent = ScreenGui

        local QuickBlockCorner = Instance.new("UICorner")
        QuickBlockCorner.CornerRadius = UDim.new(1, 0)
        QuickBlockCorner.Parent = QuickBlockBtn

        local QuickBlockStroke = Instance.new("UIStroke")
        QuickBlockStroke.Color = Color3.fromRGB(56, 189, 248)
        QuickBlockStroke.Thickness = 2.5
        QuickBlockStroke.Parent = QuickBlockBtn

        local isQuickBlockHolding = false

        local function SetBlockBtnVisual(active)
            if active then
                QuickBlockBtn.BackgroundColor3 = Color3.fromRGB(16, 185, 129)
                QuickBlockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                QuickBlockBtn.Text = "🛡️\nGUARD"
                QuickBlockStroke.Color = Color3.fromRGB(52, 211, 153)
                QuickBlockStroke.Thickness = 3.5
            else
                QuickBlockBtn.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
                QuickBlockBtn.TextColor3 = Color3.fromRGB(56, 189, 248)
                QuickBlockBtn.Text = "🛡️\nBLOCK"
                QuickBlockStroke.Color = Color3.fromRGB(56, 189, 248)
                QuickBlockStroke.Thickness = 2.5
            end
        end

        -- Hold-to-Block & Quick-Tap com resposta imediata em 0ms
        QuickBlockBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isQuickBlockHolding = true
                SetBlockBtnVisual(true)
                CombatActions.TriggerManualBlock(true)
            end
        end)

        QuickBlockBtn.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if isQuickBlockHolding then
                    isQuickBlockHolding = false
                    SetBlockBtnVisual(false)
                    CombatActions.TriggerManualBlock(false)
                end
            end
        end)

        -- 2. Botão Rápido de Auto-Combo Turbo (⚡) - Burst Máximo em 1 Toque
        local QuickComboBtn = Instance.new("TextButton")
        QuickComboBtn.Name = "ScarletQuickCombo"
        QuickComboBtn.Size = UDim2.new(0, 64, 0, 64)
        QuickComboBtn.Position = UDim2.new(1, -84, 0.65, -74)
        QuickComboBtn.BackgroundColor3 = Color3.fromRGB(36, 10, 48)
        QuickComboBtn.Text = "⚡\nCOMBO"
        QuickComboBtn.TextColor3 = Color3.fromRGB(244, 114, 182)
        QuickComboBtn.Font = Enum.Font.GothamBold
        QuickComboBtn.TextSize = 11
        QuickComboBtn.Active = true
        QuickComboBtn.AutoButtonColor = false
        QuickComboBtn.ZIndex = 120
        QuickComboBtn.Parent = ScreenGui

        local QuickComboCorner = Instance.new("UICorner")
        QuickComboCorner.CornerRadius = UDim.new(1, 0)
        QuickComboCorner.Parent = QuickComboBtn

        local QuickComboStroke = Instance.new("UIStroke")
        QuickComboStroke.Color = Color3.fromRGB(244, 114, 182)
        QuickComboStroke.Thickness = 2.5
        QuickComboStroke.Parent = QuickComboBtn

        QuickComboBtn.MouseButton1Click:Connect(function()
            QuickComboBtn.BackgroundColor3 = Color3.fromRGB(244, 63, 94)
            QuickComboBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            task.delay(0.12, function()
                QuickComboBtn.BackgroundColor3 = Color3.fromRGB(36, 10, 48)
                QuickComboBtn.TextColor3 = Color3.fromRGB(244, 114, 182)
            end)
            if SubaruState.Target then
                ExecuteSmartCombo("HYBRID_PUNCH_KICK", SubaruState.Target)
            else
                CombatActions.PerformPerfectM1(nil)
            end
        end)

        -- ==================== LÓGICA DE DRAG (TOUCH & MOUSE SMOOTH) ====================
        local function EnableDragging(frame, dragHandle)
            local dragging = false
            local dragInput, dragStart, startPos

            dragHandle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    dragStart = input.Position
                    startPos = frame.Position

                    input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then
                            dragging = false
                        end
                    end)
                end
            end)

            dragHandle.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    dragInput = input
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if input == dragInput and dragging then
                    local delta = input.Position - dragStart
                    frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                end
            end)
        end

        EnableDragging(MainFrame, Header)
        EnableDragging(FloatingBtn, FloatingBtn)
        EnableDragging(QuickBlockBtn, QuickBlockBtn)
        EnableDragging(QuickComboBtn, QuickComboBtn)

        -- Clique / Toque no Botão Flutuante alterna o Hub
        FloatingBtn.MouseButton1Click:Connect(function()
            MainFrame.Visible = not MainFrame.Visible
        end)

        -- Tecla 'V' no PC alterna o Hub, e Tecla 'F' aciona Manual Block Instantâneo (0ms) com feedback visual
        UserInputService.InputBegan:Connect(function(input, gp)
            if not gp and input.KeyCode == Enum.KeyCode.V then
                MainFrame.Visible = not MainFrame.Visible
            elseif not gp and input.KeyCode == Enum.KeyCode.F then
                SetBlockBtnVisual(true)
                CombatActions.TriggerManualBlock(true)
            end
        end)

        UserInputService.InputEnded:Connect(function(input, gp)
            if input.KeyCode == Enum.KeyCode.F then
                SetBlockBtnVisual(false)
                CombatActions.TriggerManualBlock(false)
            end
        end)

        -- Atualização dinâmica do banner de modo
        task.spawn(function()
            while ScreenGui and ScreenGui.Parent do
                if SubaruState.AdaptiveMode == "DOMINANCE" then
                    ModeBadge.Text = "MODO: 👑 DOMINANCE (>70% HP - AGRESSIVO)"
                    ModeBadge.TextColor3 = Color3.fromRGB(244, 114, 182)
                elseif SubaruState.AdaptiveMode == "TACTICAL" then
                    ModeBadge.Text = "MODO: ⚔️ TACTICAL SKIRMISH (30-70% HP)"
                    ModeBadge.TextColor3 = Color3.fromRGB(56, 189, 248)
                elseif SubaruState.AdaptiveMode == "CLUTCH_SURVIVAL" then
                    ModeBadge.Text = "MODO: ⚡ CLUTCH SURVIVAL (<30% HP - FLASH)"
                    ModeBadge.TextColor3 = Color3.fromRGB(234, 179, 8)
                elseif SubaruState.AdaptiveMode == "EXECUTE_RUSH" then
                    ModeBadge.Text = "MODO: 💀 EXECUTE RUSH (<25% INIMIGO)"
                    ModeBadge.TextColor3 = Color3.fromRGB(239, 68, 68)
                end
                task.wait(0.5)
            end
        end)

        -- Notificação nativa na tela do Roblox avisando que carregou com sucesso!
        pcall(function()
            local StarterGui = game:GetService("StarterGui")
            StarterGui:SetCore("SendNotification", {
                Title = "Scarlet 🌙 Mobile Hub V5.5",
                Text = "Hub Carregado! Toque no botão 🌙 ou aperte V para abrir. Botões rápidos 🛡️ BLOCK e ⚡ COMBO ativos na tela!",
                Duration = 6
            })
        end)
    end)
end

-- Inicia a criação do Hub de forma segura e assíncrona
task.spawn(function()
    task.wait(0.2)
    CreateScarletMobileHubGUI()
end)

return SubaruState
