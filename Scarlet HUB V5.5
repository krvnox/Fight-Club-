local function CreateScarletMobileHubGUI()
    pcall(function()
        -- 1. Resolver parent seguro para evitar erros de permissão em executores móveis e PC
        local guiParent = nil
        pcall(function()
            if gethui then
                guiParent = gethui()
            elseif syn and syn.protect_gui then
                local folder = Instance.new("Folder")
                syn.protect_gui(folder)
                folder.Parent = CoreGui
                guiParent = folder
            elseif CoreGui then
                local s = pcall(function() local _ = CoreGui.Name end)
                if s then guiParent = CoreGui end
            end
        end)
        
        if not guiParent then
            guiParent = LocalPlayer:WaitForChild("PlayerGui", 10) or LocalPlayer:FindFirstChildOfClass("PlayerGui")
        end
        
